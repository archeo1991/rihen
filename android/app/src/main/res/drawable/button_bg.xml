<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#D5E4C9" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#EDF3E7" />
            <stroke android:width="1dp" android:color="#DDE8D5" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
