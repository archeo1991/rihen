    <string name="poem_100">人生若只如初见，何事秋风悲画扇。</string>
    <string name="poem_source_100">纳兰性德《木兰花·拟古决绝词柬友》</string>
    <string name="poem_365">春有百花秋有月，夏有凉风冬有雪。</string>
    <string name="poem_source_365">无门慧开《颂平常心是道》</string>
    <string name="poem_500">行到水穷处，坐看云起时。</string>
    <string name="poem_source_500">王维《终南别业》</string>
    <string name="poem_777">山重水复疑无路，柳暗花明又一村。</string>
    <string name="poem_source_777">陆游《游山西村》</string>
    <string name="poem_1000">千淘万漉虽辛苦，吹尽狂沙始到金。</string>
    <string name="poem_source_1000">刘禹锡《浪淘沙九首·其八》</string>
    <string name="poem_1111">一蓑烟雨任平生。</string>
    <string name="poem_source_1111">苏轼《定风波·莫听穿林打叶声》</string>
    <string name="poem_1234">长风破浪会有时，直挂云帆济沧海。</string>
    <string name="poem_source_1234">李白《行路难·其一》</string>
    <string name="poem_1500">莫听穿林打叶声，何妨吟啸且徐行。</string>
    <string name="poem_source_1500">苏轼《定风波·莫听穿林打叶声》</string>
    <string name="poem_2000">路漫漫其修远兮，吾将上下而求索。</string>
    <string name="poem_source_2000">屈原《离骚》</string>
    <string name="poem_2222">两个黄鹂鸣翠柳，一行白鹭上青天。</string>
    <string name="poem_source_2222">杜甫《绝句》</string>
    <string name="poem_3000">三万里河东入海，五千仞岳上摩天。</string>
    <string name="poem_source_3000">陆游《秋夜将晓出篱门迎凉有感二首·其二》</string>
    <string name="poem_3333">三山半落青天外，二水中分白鹭洲。</string>
    <string name="poem_source_3333">李白《登金陵凤凰台》</string>
    <string name="poem_4000">海内存知己，天涯若比邻。</string>
    <string name="poem_source_4000">王勃《送杜少府之任蜀州》</string>
    <string name="poem_4444">四时俱可喜，最好新秋时。</string>
    <string name="poem_source_4444">陆游《闲适》</string>
    <string name="poem_5000">会当凌绝顶，一览众山小。</string>
    <string name="poem_source_5000">杜甫《望岳》</string>
    <string name="poem_5555">五岳寻仙不辞远，一生好入名山游。</string>
    <string name="poem_source_5555">李白《庐山谣寄卢侍御虚舟》</string>
    <string name="poem_6000">江山如画，一时多少豪杰。</string>
    <string name="poem_source_6000">苏轼《念奴娇·赤壁怀古》</string>
    <string name="poem_6666">天生我材必有用，千金散尽还复来。</string>
    <string name="poem_source_6666">李白《将进酒》</string>
    <string name="poem_7000">回首向来萧瑟处，归去，也无风雨也无晴。</string>
    <string name="poem_source_7000">苏轼《定风波·莫听穿林打叶声》</string>
    <string name="poem_7777">人生得意须尽欢，莫使金樽空对月。</string>
    <string name="poem_source_7777">李白《将进酒》</string>
    <string name="poem_8000">八百里分麾下炙，五十弦翻塞外声。</string>
    <string name="poem_source_8000">辛弃疾《破阵子·为陈同甫赋壮词以寄之》</string>
    <string name="poem_8888">潮平两岸阔，风正一帆悬。</string>
    <string name="poem_source_8888">王湾《次北固山下》</string>
    <string name="poem_9000">九万里风鹏正举。风休住，蓬舟吹取三山去。</string>
    <string name="poem_source_9000">李清照《渔家傲·天接云涛连晓雾》</string>
    <string name="poem_9999">欲穷千里目，更上一层楼。</string>
    <string name="poem_source_9999">王之涣《登鹳雀楼》</string>
    <string name="poem_10000">大鹏一日同风起，扶摇直上九万里。</string>
    <string name="poem_source_10000">李白《上李邕》</string>
    <string name="poem_11111">一点浩然气，千里快哉风。</string>
    <string name="poem_source_11111">苏轼《水调歌头·黄州快哉亭赠张偓佺》</string>
    <string name="poem_12345">仰天大笑出门去，我辈岂是蓬蒿人。</string>
    <string name="poem_source_12345">李白《南陵别儿童入京》</string>
    <string name="poem_12999">两岸猿声啼不住，轻舟已过万重山。</string>
    <string name="poem_source_12999">李白《早发白帝城》</string>
    <string name="poem_15000">且将新火试新茶，诗酒趁年华。</string>
    <string name="poem_source_15000">苏轼《望江南·超然台作》</string>
    <string name="poem_20000">人生代代无穷已，江月年年望相似。</string>
    <string name="poem_source_20000">张若虚《春江花月夜》</string>
    <string name="poem_22222">春风得意马蹄疾，一日看尽长安花。</string>
    <string name="poem_source_22222">孟郊《登科后》</string>
    <string name="poem_25000">江山代有才人出，各领风骚数百年。</string>
    <string name="poem_source_25000">赵翼《论诗五首·其二》</string>
    <string name="poem_30000">莫道桑榆晚，为霞尚满天。</string>
    <string name="poem_source_30000">刘禹锡《酬乐天咏老见示》</string>

    <string name="poem_default">胜日寻芳泗水滨，无边光景一时新。</string>
    <string name="poem_source_default">朱熹《春日》</string>
